{
  "name": "privacyspec",
  "version": "0.1.0-beta.1",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teddyoojo/PrivacySpec.git"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm --filter @privacyspec/playwright run build",
    "check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "pnpm run test:package && pnpm run test:example",
    "test:example": "pnpm --filter @privacyspec/example-basic-playwright run test",
    "test:package": "pnpm --filter @privacyspec/playwright run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "typescript": "7.0.2"
  }
}
